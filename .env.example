# Copy to .env and fill in. The .env file is git-ignored.

# Required: your OpenAI API key (issued after design-doc approval).
OPENAI_API_KEY=sk-...

# Optional: override the model used for classification and ReAct reasoning.
SUPPORT_AGENT_MODEL=openai:gpt-4o-mini

# Optional: minimum confidence required to auto-resolve instead of escalate.
SUPPORT_AGENT_AUTORESOLVE_THRESHOLD=0.75

# Optional: number of KB chunks retrieved per query.
SUPPORT_AGENT_TOP_K=4

# Optional: where Chroma persists its index.
SUPPORT_AGENT_CHROMA_DIR=data/chroma
